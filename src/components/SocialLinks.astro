---
import { site, url } from '../site.config';

interface Props {
  rss?: boolean;
  class?: string;
}
const { rss = false, class: className = '' } = Astro.props;

// Simple 24×24 outline/solid icons, inlined so there are no icon dependencies.
const links = [
  {
    label: 'Email',
    href: `mailto:${site.email}`,
    icon: '<rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  },
  {
    label: 'GitHub',
    href: site.links.github,
    icon: '<path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.36-3.37-1.36-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.6.69.49A10.1 10.1 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>',
  },
  {
    label: 'LinkedIn',
    href: site.links.linkedin,
    icon: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  },
  {
    label: 'X (Twitter)',
    href: site.links.twitter,
    icon: '<path fill="currentColor" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.09 14.45Z"/>',
  },
  ...(rss
    ? [
        {
          label: 'RSS feed',
          href: url('rss.xml'),
          icon: '<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="6" cy="18" r="1.6" fill="currentColor"/>',
        },
      ]
    : []),
];
---

<ul class={`flex items-center gap-1 ${className}`}>
  {
    links.map(({ label, href, icon }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-mark hover:text-fg"
          {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener me' } : {})}
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true" set:html={icon} />
        </a>
      </li>
    ))
  }
</ul>
