---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { url } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 230));
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="mb-10">
      <a href={url('blog/')} class="text-sm text-muted transition-colors hover:text-fg">← All posts</a>
      <h1 class="mt-6 text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 flex flex-wrap gap-x-3 font-mono text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {post.data.draft && <span class="rounded bg-mark px-1.5 text-fg">draft</span>}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2 text-xs">
            {post.data.tags.map((t) => (
              <li class="rounded-md bg-surface px-2 py-1 font-mono text-muted">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt=""
          widths={[672, 1344]}
          sizes="(min-width: 42rem) 42rem, 100vw"
          class="mb-10 aspect-[2/1] w-full rounded-xl object-cover"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav aria-label="More posts" class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
        {older ? (
          <a href={url(`blog/${older.id}/`)} class="rounded-lg p-3 transition-colors hover:bg-surface">
            <span class="eyebrow">← Older</span>
            <span class="mt-1 block font-medium">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a href={url(`blog/${newer.id}/`)} class="rounded-lg p-3 text-right transition-colors hover:bg-surface">
            <span class="eyebrow">Newer →</span>
            <span class="mt-1 block font-medium">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>
