---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(projects.map(async (p) => ({ ...p, Content: (await render(p)).Content, hasBody: !!p.body?.trim() })));
---

<Base title="Projects" description="Things I've built and worked on.">
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
  <p class="mt-3 text-muted">Things I've built, contributed to, or am tinkering with.</p>

  <ul class="mt-12 space-y-4">
    {
      rendered.map(({ data, Content, hasBody }) => (
        <li class="rounded-xl border border-border p-5 transition-colors hover:border-[var(--mark-strong)] sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-lg font-semibold tracking-tight">
              {data.url ? <a class="marker" href={data.url}>{data.name}</a> : data.name}
            </h2>
            <p class="font-mono text-sm text-muted">
              {data.year}
              {data.status === 'active' && <span class="ml-2 rounded-full bg-mark px-2 py-0.5 text-xs text-fg">active</span>}
            </p>
          </div>
          <p class="mt-2 text-[0.97rem]">{data.description}</p>
          {hasBody && (
            <div class="prose mt-3 text-[0.94rem] text-muted">
              <Content />
            </div>
          )}
          {(data.tags.length > 0 || data.repo) && (
            <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
              {data.tags.map((t) => (
                <span class="rounded-md bg-surface px-2 py-1 font-mono text-muted">{t}</span>
              ))}
              {data.repo && (
                <a href={data.repo} class="marker ml-auto font-mono text-muted">
                  source →
                </a>
              )}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Base>
